# LibertAI inference
LIBERTAI_API_KEY=
LIBERTAI_BASE_URL=https://api.libertai.io
LIBERTAI_DEFAULT_MODEL=hermes-3-8b-tee

# Protects scenario and MCP editing. Leave empty for local development; set it before
# exposing the API to a network, or anyone can rewrite your scenarios.
ADMIN_TOKEN=

# Encrypts MCP credentials at rest. If unset, a key file is generated at
# apps/api/.secret_key — back it up, or stored credentials become unreadable.
AVATAR_SECRET_KEY=

# Storage and tool behaviour
AVATAR_DB=apps/api/avatar.db
MCP_TOOL_TIMEOUT=15
MCP_DISCOVERY_TTL=300
PIPER_VOICES_DIR=apps/api/voices
